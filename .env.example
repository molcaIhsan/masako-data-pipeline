# Copy to .env and fill in. .env is git-ignored.
# ---- Kafka (the EXISTING broker with the machine data; for local simulation use kafka:9092 + --profile sim) ----
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=machine_metrics
KAFKA_DLQ_TOPIC=machine_metrics_dlq
KAFKA_GROUP_ID=flink-silver
KAFKA_STARTING_OFFSETS=earliest          # first deploy only; afterwards offsets come from checkpoints
# Optional client security: KAFKA_PROP_<property with _ for .>, e.g.
# KAFKA_PROP_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_PROP_SASL_MECHANISM=SCRAM-SHA-512
# KAFKA_PROP_SASL_JAAS_CONFIG=org.apache.kafka.common.security.scram.ScramLoginModule required username="u" password="p";

# ---- TimescaleDB (silver + gold) ----
PG_HOST=timescaledb
PG_PORT=5432
PG_DATABASE=masako
POSTGRES_PASSWORD=change-me              # superuser (dev container only)
FLINK_PG_USER=flink_silver
FLINK_PG_PASSWORD=change-me
AIRFLOW_PG_USER=airflow_gold
AIRFLOW_PG_PASSWORD=change-me

# ---- Postgres CDC for master data (db/cdc/enable_cdc.sh) ----
FLINK_CDC_USER=flink_cdc
FLINK_CDC_PASSWORD=change-me
FLINK_CDC_SLOT=flink_master_slot
FLINK_CDC_PUBLICATION=flink_master_pub
FLINK_CDC_SCHEMA=silver

# ---- Flink job behaviour ----
FLINK_PARALLELISM=2
WATERMARK_LATENESS_SECONDS=60
UNRESOLVED_RETRY_SECONDS=300
CHECKPOINT_INTERVAL_SECONDS=60
SINK_BATCH_SIZE=500
SINK_FLUSH_MS=1000
